{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/flight-service/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "tsconfig.build.json"
  },
  "monorepo": true,
  "root": "apps/flight-service",
  "projects": {
    "flight-service": {
      "type": "application",
      "root": "apps/flight-service",
      "entryFile": "main",
      "sourceRoot": "apps/flight-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/flight-service/tsconfig.app.json"
      }
    },
    "hotel-service": {
      "type": "application",
      "root": "apps/hotel-service",
      "entryFile": "main",
      "sourceRoot": "apps/hotel-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/hotel-service/tsconfig.app.json"
      }
    },
    "insurance-service": {
      "type": "application",
      "root": "apps/insurance-service",
      "entryFile": "main",
      "sourceRoot": "apps/insurance-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/insurance-service/tsconfig.app.json"
      }
    },
    "transfer-service": {
      "type": "application",
      "root": "apps/transfer-service",
      "entryFile": "main",
      "sourceRoot": "apps/transfer-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/transfer-service/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    }
  }
}
