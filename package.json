{
  "name": "t-travel-booking-orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "T-Travel Booking Orchestrator monorepo",
  "scripts": {
    "build:all": "nest build flight-service && nest build hotel-service && nest build insurance-service && nest build transfer-service",
    "build:common": "pnpm --filter @t-amada/common run build",
    "start:flight": "nest start flight-service --watch",
    "start:hotel": "nest start hotel-service --watch",
    "start:insurance": "nest start insurance-service --watch",
    "start:transfer": "nest start transfer-service --watch",
    "start:all": "pnpm --parallel run start:dev",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "format": "prettier --write \"{apps,libs}/**/*.ts\"",
    "test": "pnpm --recursive run test",
    "db:generate:all": "pnpm --filter \"./apps/*\" run db:generate",
    "db:push:all": "pnpm --filter \"./apps/*\" run db:push",
    "studio:flight": "pnpm --filter @t-amada/flight-service run db:studio",
    "studio:hotel": "pnpm --filter @t-amada/hotel-service run db:studio --port 4984",
    "studio:insurance": "pnpm --filter @t-amada/insurance-service run db:studio --port 4985",
    "studio:transfer": "pnpm --filter @t-amada/transfer-service run db:studio --port 4986"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.2",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}
